# Build the frontend independently; do not install Node or execute a remote setup
# script inside the Python runtime image.
FROM node:22-bookworm-slim AS frontend
WORKDIR /ui
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libopenblas-dev libglib2.0-0 libsm6 libxext6 \
    libxrender1 libgl1 tesseract-ocr ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY backend/ /app/backend/
COPY --from=frontend /ui/dist/ /app/frontend/dist/
RUN mkdir -p /app/data /app/media/originals /app/media/thumbnails
WORKDIR /app/backend
EXPOSE 5050
CMD ["python", "app.py"]
